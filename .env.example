# Copy to .env and fill in. Real environment variables take precedence over .env.
# Lockstep loads the nearest .env (searching cwd upward). Only set the keys for
# the providers your targets actually use — `lockstep doctor` shows which are needed.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Google Gemini (either name works)
GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# OpenRouter (one key, hundreds of models)
OPENROUTER_API_KEY=sk-or-...

# Optional endpoint overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_HOST=http://localhost:11434      # local Ollama — no key needed
